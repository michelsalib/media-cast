{
  "name": "media-cast",
  "version": "2.4.2",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://micheldev.com/media-cast",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michelsalib/media-cast.git"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "lint": "biome check .",
    "prepare:binaries": "bun scripts/download-ffmpeg.mjs",
    "prepare:icons": "bun scripts/build-icons.mjs",
    "dump:burnin": "bun scripts/dump-burnin-frames.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "bun check && electron-vite build",
    "postinstall": "bun scripts/download-datachannel.mjs",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "bun run build && electron-builder --mac --universal",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/figtree": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@types/send": "^1.2.1",
    "bonjour-service": "^1.4.4",
    "castv2-client": "^1.2.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "format-duration": "^4.0.0",
    "qrcode": "^1.5.4",
    "send": "^1.2.1",
    "webtorrent": "^3.0.21"
  },
  "overrides": {
    "protobufjs": "^7.5.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^25.9.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webtorrent": "^3.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "icon-gen": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.6"
  }
}
